# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=changeme_generate_a_real_secret

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=dutch_kis
POSTGRES_PASSWORD=dutch_kis_secret
POSTGRES_DB=dutch_kis
DATABASE_URL=postgresql://dutch_kis:dutch_kis_secret@localhost:5432/dutch_kis

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Ollama (AI inference) ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── Coqui TTS ────────────────────────────────────────────────────────────────
TTS_BASE_URL=http://localhost:5002

# ─── SpaCy NLP Service ────────────────────────────────────────────────────────
NLP_BASE_URL=http://localhost:8001

# ─── MinIO (Object Storage) ───────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=dutch_kis
MINIO_ROOT_PASSWORD=dutch_kis_minio_secret
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_AUDIO=audio-recordings

# ─── Email (Mailpit in dev, Resend/SendGrid in prod) ──────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@dutch-kis.local
# Production: set SMTP_USER and SMTP_PASS for your email provider

# ─── Error Monitoring (GlitchTip) ─────────────────────────────────────────────
GLITCHTIP_DSN=
# Generate with: openssl rand -base64 32
GLITCHTIP_SECRET_KEY=changeme_glitchtip_secret

# ─── OAuth Providers (optional) ───────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_INBURGERING_MODE=true
ENABLE_IDIOM_LIBRARY=true
ENABLE_DOCUMENT_LIBRARY=true
ENABLE_IOS_PUSH_NOTIFICATIONS=false

# ─── Paid AI APIs (optional — can be added later) ─────────────────────────────
# ELEVENLABS_API_KEY=       # swap Coqui TTS for higher-quality Dutch voice
# OPENAI_API_KEY=           # fallback if Ollama performance is insufficient
